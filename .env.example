# --- LLM providers (at least one; MOCK_LLM=1 needs none) ---
LLM_PROVIDER=gemini            # gemini | groq | mock
GEMINI_API_KEY=
GROQ_API_KEY=
MOCK_LLM=0

# --- Swytchcode ---
SWY_PROJECT=ledgerpilot

# --- Toolkits ---
GMAIL_ENABLED=1                # 0 = always use seed/invoices.json (demo mode)
PAYPAL_ENV=sandbox             # sandbox only — enforced

# --- Agent behavior ---
MAX_INVOICES=10
APPROVAL_TIMEOUT_S=120

# --- Server ---
HOST=127.0.0.1
PORT=8000
